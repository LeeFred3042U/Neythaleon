# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
DB_TABLE=ingested_data


# Folders
PARQUET_DIR=parquet
FAILED_DIR=failed_chunks
MEDIA_DIR=media


# Ingestion
CHUNK_SIZE=10000
VALIDATE_COORDS=false
INT_COLUMNS=year,individualCount


# Metrics & Logging
METRICS_FILE=media/ingestion_metrics.csv
LOG_FILE=ingestion.log


# Throttling
CPU_THRESHOLD=85
RAM_THRESHOLD=85.0
THROTTLE_DELAY_HIGH_CPU=2
THROTTLE_DELAY=0

# Advanced Settings
MANIFEST_FILE=schema_manifest.json
FAIL_FAST=false
EXPECTED_THROUGHPUT_RPS=50000
GRAPH_SAMPLE_LIMIT=500000
TARGET_CHUNK_MB=256

# Parallelism (defaults auto-detected from CPU count if omitted)
# N_TRANSFORM_WORKERS = number of CPU processes for data transformation (default: cpu_count-1)
# N_WRITE_THREADS     = number of threads for concurrent DB writes (default: 4)
# QUEUE_DEPTH         = max chunks in-flight at once, controls memory backpressure (default: 8)
#N_TRANSFORM_WORKERS=7
#N_WRITE_THREADS=4
#QUEUE_DEPTH=8