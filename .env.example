# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
DB_TABLE=ingested_data


# Folders
PARQUET_DIR=parquet
FAILED_DIR=failed_chunks
MEDIA_DIR=media


# Ingestion
CHUNK_SIZE=10000
VALIDATE_COORDS=false
INT_COLUMNS=year,individualCount


# Metrics & Logging
METRICS_FILE=media/ingestion_metrics.csv
LOG_FILE=ingestion.log


# Throttling
CPU_THRESHOLD=85
RAM_THRESHOLD=85.0
THROTTLE_DELAY_HIGH_CPU=2
THROTTLE_DELAY=0

# Advanced Settings
MANIFEST_FILE=schema_manifest.json
FAIL_FAST=false
GRAPH_SAMPLE_LIMIT=500000
TARGET_CHUNK_MB=256

# Parallelism (defaults auto-detected from CPU count if omitted)
# N_TRANSFORM_WORKERS = number of CPU processes for data transformation (default: cpu_count-1)
# N_WRITE_THREADS     = number of threads for concurrent DB writes (default: 4)
# QUEUE_DEPTH         = max chunks in-flight at once, controls memory backpressure (default: 8)
#N_TRANSFORM_WORKERS=7
#N_WRITE_THREADS=4
#QUEUE_DEPTH=8

# AI Advisor (all optional) 
# LLM_PROVIDER selects which backend to use.
#   Defaults: anthropic (if ANTHROPIC_API_KEY set), openai (if OPENAI_API_KEY set), else ollama
LLM_PROVIDER=anthropic          # anthropic | openai | ollama | openai_compat
LLM_MODEL=claude-sonnet-4-5     # model name — provider-specific default used if omitted

# Anthropic (https://console.anthropic.com)
#ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (https://platform.openai.com)
#OPENAI_API_KEY=sk-...

# OpenAI-compatible endpoint (LM Studio, Groq, Together AI, etc.)
#LLM_PROVIDER=openai_compat
#OPENAI_BASE_URL=http://localhost:1234/v1
#OPENAI_API_KEY=not-needed         # some endpoints accept any string

# Ollama (no API key needed — Ollama must be running locally)
#LLM_PROVIDER=ollama
#OLLAMA_MODEL=llama3               # model name pulled with: ollama pull llama3